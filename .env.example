# Use mock data until the NetSuite account configuration and field mappings are
# verified. Do not prefix these values with VITE_; they belong to Electron's
# main process and must not be exposed to the renderer bundle.
DATA_SOURCE=mock

# Non-secret NetSuite Public Client configuration. Leave these blank in source
# control. Never add access tokens, refresh tokens, a client secret, or private
# keys to an environment file.
NETSUITE_ACCOUNT_ID=
NETSUITE_ACCOUNT_DOMAIN=
NETSUITE_CLIENT_ID=
NETSUITE_REDIRECT_URI=hauser-backlog://oauth/callback
NETSUITE_SCOPE=rest_webservices

